# Frontend environment template. Copy to .env and fill in.
# NOTE: every REACT_APP_* value is inlined into the built JavaScript bundle at
# build time and is therefore PUBLIC. Never put a secret here.

# 'sandbox' selects the FBR /postinvoicedata_sb endpoint; anything else uses production.
REACT_APP_FBR_ENVIRONMENT=sandbox

# Base URL of the backend API.
REACT_APP_API_URL=http://localhost:5001
