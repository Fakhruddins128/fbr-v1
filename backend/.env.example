# Backend environment template. Copy to .env and fill in.
# This file must contain NO real values - backend/.env is git-ignored for a reason.

# Server
PORT=5001

# Database (SQL Server)
DB_USER=
DB_PASSWORD=          # SECRET
DB_HOST=
DB_INSTANCE=
DB_NAME=
DB_PORT=1433

# Auth
# SECRET. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this invalidates every issued JWT and forces all users to log in again.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# FBR API
FBR_API_BASE_URL=
FBR_API_ENVIRONMENT=sandbox
FBR_INVOICE_SUBMISSION_ENDPOINT_SANDBOX=
FBR_INVOICE_VALIDATION_ENDPOINT_SANDBOX=
FBR_INVOICE_SUBMISSION_ENDPOINT_PRODUCTION=
FBR_INVOICE_VALIDATION_ENDPOINT_PRODUCTION=
